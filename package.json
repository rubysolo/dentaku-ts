{
  "name": "dentaku",
  "version": "0.1.0",
  "description": "Safe parser and evaluator for math and logic formulas with run-time variable binding — the TypeScript successor to the Ruby dentaku calculator",
  "keywords": [
    "formula",
    "parser",
    "evaluator",
    "calculator",
    "excel",
    "dentaku",
    "expression",
    "safe-eval"
  ],
  "license": "MIT",
  "author": "Solomon White",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubysolo/dentaku-ts.git"
  },
  "bugs": {
    "url": "https://github.com/rubysolo/dentaku-ts/issues"
  },
  "homepage": "https://github.com/rubysolo/dentaku-ts#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "26.1.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@10.34.4"
}
